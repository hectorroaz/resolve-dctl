DEFINE_UI_PARAMS(timeGamma, Timeline Gamma, DCTLUI_COMBO_BOX, 0, {SCENE, LINEAR}, {Scene, Linear})

__DEVICE__ float lin_to_rec(float x)
{
    if (x < 0.0018f)
        return 4.5f * x;
    else
        return 1.099f * powf(x, 0.45f) - 0.099f;
}

__DEVICE__ float3 apply_gamma(float3 c)
{
    if (timeGamma == SCENE)
    {
        c.x = lin_to_rec(c.x);
        c.y = lin_to_rec(c.y);
        c.z = lin_to_rec(c.z);
    }
    return c;
}

__DEVICE__ float3 transform(float3 in, float2 uv, int2 size)
{
    int section = size.x / 3;

    float3 out;

    if (uv.x * size.x >= section * 2)
    {
        // White
        out = make_float3(1.0f, 1.0f, 1.0f);
    }
    else if (uv.x * size.x >= section)
    {
        // 18% Gray
        out = make_float3(0.18f, 0.18f, 0.18f);
    }
    else
    {
        // Black
        out = make_float3(0.0f, 0.0f, 0.0f);
    }

    out = apply_gamma(out);

    return out;
}
